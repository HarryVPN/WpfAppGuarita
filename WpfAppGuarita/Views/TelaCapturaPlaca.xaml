<Page x:Class="WpfAppGuarita.Views.TelaCapturaPlaca"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Captura de Placa" Background="#F2F2F2">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Câmera -->
            <RowDefinition Height="Auto"/>
            <!-- Controles -->
        </Grid.RowDefinitions>

        <!-- Elementos de suporte para o C# -->
        <TextBlock x:Name="txtStatus" Visibility="Collapsed" />

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reconhecimento de Veículos" FontSize="26" FontWeight="ExtraBold" Foreground="#222"/>
        </StackPanel>

        <!-- 2. ÁREA DA CÂMERA -->
        <Border Grid.Row="1" Background="Black" CornerRadius="15" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Image x:Name="WebcamImage" Stretch="Uniform"/>
            </Grid>
        </Border>

        <!-- 3. PAINEL DE CONTROLE -->
        <Grid Grid.Row="2" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Card de Placa -->
            <Border Background="White" CornerRadius="12" Padding="25,15" HorizontalAlignment="Left" MinWidth="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="PLACA IDENTIFICADA" FontSize="11" FontWeight="Bold" Foreground="#AAA" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtPlacaDetectada" 
                               Text="AGUARDANDO..." 
                               FontSize="38" FontWeight="Black" 
                               Foreground="#FFF2BC18" />
                </StackPanel>
            </Border>

            <!-- Botões -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">

                <!-- Botão Limpar -->
                <Button Content="LIMPAR" Click="BotaoLimpar_Click"
                        Width="110" Height="50" Margin="0,0,10,0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Background="#E0E0E0" Foreground="#444" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Botão Registros -->
                <Button Content="REGISTROS" Click="BtnRegistros"
                        Width="130" Height="50" Margin="0,0,10,0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Background="#333" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Botão Confirmar (Principal) -->
                <Button Content="CONFIRMAR ACESSO" Click="BtnSalvarFoto"
                        Width="220" Height="65"
                        FontSize="16" FontWeight="Black" Cursor="Hand"
                        Background="#FFF2BC18" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#FFF2BC18"/>
                    </Button.Effect>
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Page>
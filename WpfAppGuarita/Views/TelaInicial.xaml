<Page x:Class="WpfAppGuarita.Views.TelaInicial"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgBrush}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="212" Height="212" CornerRadius="120,120,120,120"
                    BorderBrush="#FFF2BC18" BorderThickness="3"
                    Margin="0,0,0,40">
                <Image Source="/Assets/logo.png" 
                   Width="160" Height="160" 
                   Stretch="Uniform" 
                   Margin="23,21,23,25"/>
            </Border>

            <TextBlock Text="Reconhecimento Digital de Veículos"
                       FontSize="56" FontWeight="ExtraBold"
                       Foreground="#393839" 
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Segurança, automação e leitura de placas em alta precisão."
                       FontSize="20" Foreground="{StaticResource MutedFgBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,32"/>

            <Button Content="INICIAR" Width="320" Style="{StaticResource BotaoPrimario}"
                    HorizontalAlignment="Center"
                    FontSize="26" Click="OnIniciar" Background="#FFF2BC18" FontWeight="EXTRABOLD" Foreground="#FFFFFFFF"/>
            
        </StackPanel>
    </Grid>
</Page>